<!-- DUMMY TEST COPY - not a source of truth; real source: st185-link-ecu-config/link_g4x_can_setup.json @ 60fd99c4, link_g4x_can_setup.lcs @ 60fd99c4 and switchboard_frames.json @ 3df293f2 (format only); PDM values from firmware/dbc/custompdm_PDM.dbc; never use alone to decide a design change (Dan, 2026-11-16) -->
<!-- custom-pdm status frames as Link G4X RECEIVE channels (L1a). Generated by ui/tools/DbcGen from
     ui/dingoConfig/domain/CustomPdm/DbcExport.cs (same signals as firmware/dbc): do not edit.
     JSON master form beside it: link_pdm_receive.dummy.json (ENCODE form). SCALE CONVENTION here, as st185's .lcs:
     DECODE, value = raw x Scale + Offset. PDM frames are Intel byte order: ByteOrder="LittleEndian",
     StartBit = DBC Intel start bit (byte x 8 + bit, bit 0 = LSB). Timeout 400 ms (4 x the 100 ms cycle,
     st185 master design section 6), every channel reads 0 on time-out.
     Not verified: PCLink import of receive channels / LittleEndian from an .lcs; receive channel count. -->
<LinkCANSetup Version="1">
  <CANModule Index="1">
    <!-- CAN1, 1 Mbit/s: the one car bus (st185 CAN-BUS-MASTER-DESIGN.md) -->


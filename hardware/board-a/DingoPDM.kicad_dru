(version 1)

# >>> custom-pdm tools/drc_erc_waivers.py (generated; edit the tool, not this block)
# USB-C J5 (GCT USB4085 maker land pattern, stock dingoPDM): 0.85 mm pin pitch leaves 0.15 mm pad gap and
# 0.15 mm ring. JLCPCB limits (min ring 0.13 mm, min gap 0.1 mm) pass: tools/gen_fab_jlcpcb.py JLC-limit DRC.
(rule "custom-pdm: USB-C J5 maker land pattern"
	(condition "A.memberOfFootprint('J5') && B.memberOfFootprint('J5')")
	(constraint clearance (min 0.15mm))
	(constraint hole_clearance (min 0.1mm)))
(rule "custom-pdm: USB-C J5 maker ring"
	(condition "A.memberOfFootprint('J5')")
	(constraint annular_width (min 0.15mm)))
# The J5 silk outline is drawn to the board edge (the receptacle sits on the edge); the fab clips it.
(rule "custom-pdm: USB-C J5 silk at board edge (cosmetic, clipped by the fab)"
	(severity exclusion)
	(condition "(A.memberOfFootprint('J5') || B.memberOfFootprint('J5')) && (A.Layer == 'Edge.Cuts' || B.Layer == 'Edge.Cuts')")
	(constraint silk_clearance (min 0mm)))
# Courtyard overlaps, no copper or body clash (DRC copper clearance is clean for every pair):
#  U14 (OKI-78SR, DNP alternate 5 V footprint, kept from stock) vs the fitted LMZM23601V5 module + caps (hw5v);
#  J1 / H1 (12 V terminal beside its mounting hole), JP1 / U2: stock dingoPDM patterns;
#  board B T1-T4 terminals vs U8-U11 and T1/T3, T2/T4: courtyard margins only, bodies 2.3 mm apart (docs/pcb-verification.md).
(rule "custom-pdm: courtyard overlap without body or copper clash"
	(severity exclusion)
	(condition "(A.Reference == 'U14' && B.Reference == 'U21') || (A.Reference == 'U21' && B.Reference == 'U14') || (A.Reference == 'U14' && B.Reference == 'C55') || (A.Reference == 'C55' && B.Reference == 'U14') || (A.Reference == 'U14' && B.Reference == 'C56') || (A.Reference == 'C56' && B.Reference == 'U14') || (A.Reference == 'U14' && B.Reference == 'C57') || (A.Reference == 'C57' && B.Reference == 'U14') || (A.Reference == 'U14' && B.Reference == 'C4') || (A.Reference == 'C4' && B.Reference == 'U14') || (A.Reference == 'J1' && B.Reference == 'H1') || (A.Reference == 'H1' && B.Reference == 'J1') || (A.Reference == 'JP1' && B.Reference == 'U2') || (A.Reference == 'U2' && B.Reference == 'JP1')")
	(constraint courtyard_clearance (min 0mm)))
# Silk lines / text of Y1, SW1 run over pad openings: the fab removes silk from the mask openings
# (cosmetic: the line is printed shorter; no solderability effect).
(rule "custom-pdm: silk clipped by solder mask (cosmetic)"
	(severity exclusion)
	(condition "(A.memberOfFootprint('Y1') || B.memberOfFootprint('Y1') || A.memberOfFootprint('SW1') || B.memberOfFootprint('SW1')) && (A.Type == 'pad' || B.Type == 'pad')")
	(constraint silk_clearance (min 0mm)))
# <<< custom-pdm tools/drc_erc_waivers.py

@using application.Services
@using domain.Enums
@using domain.CustomPdm
@using web.Components.Devices.FwDevice.Functions
@using web.Services
@inject UserPreferencesManager UserPrefs
@inject NotificationService Notification
@typeparam TDevice where TDevice : domain.Devices.FwDevice
@inherits FunctionComponentBase<TDevice>

<div
    style="overflow-y: auto; height: calc(100vh - 250px); padding: 24px; scrollbar-width: auto; scrollbar-color: #888 transparent;">
    <MudExpansionPanels MultiExpansion="true">

        <MudExpansionPanel Text="Device">
            <MudGrid Spacing="4">
                <MudItem>
                    <MudCard Elevation="4" Style="height: 100%">
                        <MudCardContent>
                            <MudText Typo="Typo.body1">CAN</MudText>
                            <MudTextField Value="@_baseId"
                                          ValueChanged="@((string val) => @Device.BaseId = Utils.ParseId(val, UserPrefs.Preferences.IdFormat, Notification))"
                                          Label="Base ID"
                                          Variant="Variant.Outlined"
                                          Style="max-width: 200px"
                                          T="string"/>
                            <MudSelect @bind-Value="@Device.BitRate"
                                       Label="@(Device.Def.NumCanBuses > 1 ? "CAN 1 Bitrate" : "Bitrate")"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       Class="mb-3"
                                       T="CanBitRate"
                                       Style="max-width: 200px">
                                <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate1000K)">1000K</MudSelectItem>
                                <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate500K)">500K</MudSelectItem>
                                <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate250K)">250K</MudSelectItem>
                                <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate125K)">125K</MudSelectItem>
                                <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate100K)">100K</MudSelectItem>
                            </MudSelect>
                            @if (Device.Def.NumCanBuses > 1)
                            {
                                <MudSelect @bind-Value="@Device.BitRate2"
                                           Label="CAN 2 Bitrate"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Class="mb-3"
                                           T="CanBitRate"
                                           Style="max-width: 200px">
                                    <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate1000K)">1000K</MudSelectItem>
                                    <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate500K)">500K</MudSelectItem>
                                    <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate250K)">250K</MudSelectItem>
                                    <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate125K)">125K</MudSelectItem>
                                    <MudSelectItem T="CanBitRate" Value="@(CanBitRate.BitRate100K)">100K</MudSelectItem>
                                </MudSelect>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem>
                    <MudCard Elevation="4" Style="height: 100%">
                        <MudCardContent>
                            <MudText Typo="Typo.body1">CAN</MudText>
                            <MudSwitch @bind-Value="@Device.CanFiltersEnabled"
                                       Color="Color.Success"
                                       Label="CAN Filters Enabled"/>
                            @if (Device.Def.HasUsb)
                            {
                                <MudSwitch @bind-Value="@Device.ConnectUsbToCan"
                                           Color="Color.Success"
                                           Label="Connect USB to CAN"/>
                            }
                            <MudPaper>
                                <MudText Typo="Typo.body1">Mute CAN TX Input</MudText>
                                <MudStack Row="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Style="max-width: 20px"
                                                   OnClick="@(() => OpenVariableSelectorAsync(["bool"], v => Device.MuteCanTxInput = v))">
                                    </MudIconButton>
                                    <MudText>@GetSelectedVarText(Device.MuteCanTxInput)</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                @if (Device.Def.CanSleep)
                {
                    <MudItem>
                        <MudCard Elevation="4" Style="height: 100%">
                            <MudCardContent>
                                <MudText Typo="Typo.body1">Sleep</MudText>
                                <MudSwitch @bind-Value="@Device.SleepEnabled"
                                           Color="Color.Success"
                                           Label="Sleep Enabled"/>
                                <MudSwitch @bind-Value="@Device.DisableDigInWake"
                                           Color="Color.Success"
                                           Label="Disable Digital Input Wake"/>
                                <MudSwitch @bind-Value="@Device.DisableCanWake"
                                           Color="Color.Success"
                                           Label="Disable CAN Wake"/>
                                <MudPaper>
                                    <MudText Typo="Typo.body1">Force Sleep Input</MudText>
                                    <MudStack Row="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Search"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Style="max-width: 20px"
                                                       OnClick="@(() => OpenVariableSelectorAsync(["bool"], v => Device.ForceSleepInput = v))">
                                        </MudIconButton>
                                        <MudText>@GetSelectedVarText(Device.ForceSleepInput)</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
                @* custom-pdm: param block 0x7F00, device types 14 / 15 only (CustomPdm is null for stock types) *@
                @if (Device.CustomPdm is { } cpdm)
                {
                    <MudItem>
                        <MudCard Elevation="4" Style="height: 100%">
                            <MudCardContent>
                                <MudText Typo="Typo.body1">Board Temperature Limits</MudText>
                                <MudNumericField T="int" @bind-Value="cpdm.TempWarn" Label="Warn (°C)"
                                                 Min="CustomPdmSettings.TempMin" Max="CustomPdmSettings.TempMax"
                                                 Variant="Variant.Outlined" Style="max-width: 200px"/>
                                <MudNumericField T="int" @bind-Value="cpdm.TempCrit" Label="Critical, all outputs off (°C)"
                                                 Min="CustomPdmSettings.TempMin" Max="CustomPdmSettings.TempMax"
                                                 Variant="Variant.Outlined" Style="max-width: 200px"/>
                                <MudNumericField T="int" @bind-Value="cpdm.TempCritHyst" Label="Recovery below critical (°C)"
                                                 Min="CustomPdmSettings.HystMin" Max="CustomPdmSettings.HystMax"
                                                 Variant="Variant.Outlined" Style="max-width: 200px"/>
                                <MudNumericField T="int" @bind-Value="cpdm.TempCritSoonMargin" Label="Critical-soon margin (°C, 0 = off)"
                                                 Min="CustomPdmSettings.MarginMin" Max="CustomPdmSettings.MarginMax"
                                                 Variant="Variant.Outlined" Style="max-width: 200px"/>
                                <MudText Typo="Typo.body2" Class="mt-2">Outputs kept on at critical</MudText>
                                @for (var i = 0; i < cpdm.NumOutputs; i++)
                                {
                                    var bit = i;
                                    <MudCheckBox T="bool" Dense="true" Label="@Device.Outputs[bit].Name"
                                                 Value="@((cpdm.CritExemptMask & (1 << bit)) != 0)"
                                                 ValueChanged="@((bool v) => cpdm.CritExemptMask = v ? cpdm.CritExemptMask | (1 << bit) : cpdm.CritExemptMask & ~(1 << bit))"/>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem>
                        <MudCard Elevation="4" Style="height: 100%">
                            <MudCardContent>
                                <MudText Typo="Typo.body1">Wake Inputs</MudText>
                                <MudText Typo="Typo.caption">CAN and USB always wake. Ignored while Disable Digital Input Wake is on. One input per shared wake line.</MudText>
                                @for (var i = 0; i < cpdm.NumDigitalInputs; i++)
                                {
                                    var bit = i;
                                    var label = Device.DigitalInputs[bit].Name + (cpdm.WakeInputNeverAllowed(bit) ? " (USB line, cannot wake)" : "");
                                    <MudCheckBox T="bool" Dense="true" Label="@label"
                                                 Disabled="@cpdm.WakeInputBlocked(bit)"
                                                 Value="@((cpdm.WakeInputMask & (1 << bit)) != 0)"
                                                 ValueChanged="@((bool v) => cpdm.WakeInputMask = v ? cpdm.WakeInputMask | (1 << bit) : cpdm.WakeInputMask & ~(1 << bit))"/>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    @* custom-pdm P3 (0x7F00 sub 6) *@
                    <MudItem>
                        <MudCard Elevation="4" Style="height: 100%">
                            <MudCardContent>
                                <MudText Typo="Typo.body1">Master Retry</MudText>
                                <MudText Typo="Typo.caption">On the rising edge of this input every output in Overcurrent or Fault is cleared and follows its input again. None = off.</MudText>
                                <MudStack Row="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Style="max-width: 20px"
                                                   OnClick="@(() => OpenVariableSelectorAsync(["bool"], v => cpdm.MasterRetryInput = v))">
                                    </MudIconButton>
                                    <MudText>@GetSelectedVarText(cpdm.MasterRetryInput)</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
                @if (Device.Keypads.Count > 0)
                {
                    <MudItem>
                        <MudCard Elevation="4" Style="height: 100%">
                            <MudCardContent>
                                <MudText Typo="Typo.body1">Keypad</MudText>
                                @foreach (var kp in Device.Keypads)
                                {
                                    var label = $"Keypad {kp.Number} Enabled";
                                    <MudSwitch @bind-Value="kp.Enabled"
                                               Color="Color.Success"
                                               Label=@label/>
                                    @if (Device.Def.NumCanBuses > 1)
                                    {
                                        <BusSelect @bind-Value="kp.Bus"
                                                   NumBuses="Device.Def.NumCanBuses"
                                                   Label="@($"Keypad {kp.Number} Bus")"
                                                   Disabled="!kp.Enabled"/>
                                    }
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudExpansionPanel>

        @* Outputs *@
        @if (Device.Outputs.Count > 0)
        {
            <MudExpansionPanel Text="@($"Outputs ({Device.Outputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _outputsExpanded = expanded)">
                @if (_outputsExpanded)
                {
                    <OutputsGrid Outputs="Device.Outputs" Device="Device"/>
                }
            </MudExpansionPanel>

            @* Outputs PWM *@
            <MudExpansionPanel Text="@($"Outputs PWM ({Device.Outputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _outputsPwmExpanded = expanded)">
                @if (_outputsPwmExpanded)
                {
                    <OutputsPwmGrid Outputs="Device.Outputs" Device="Device"/>
                }
            </MudExpansionPanel>

            @* custom-pdm P1 / P2: block 0x7D00 + output, device types 14 / 15 only *@
            @if (Device.CustomPdm is { } cpro)
            {
                <MudExpansionPanel Text="@($"Output Protection: Trip Time, Open Load ({Device.Outputs.Count})")">
                    <MudText Typo="Typo.caption">
                        Trip time: how long the current may stay above the current limit (after the inrush time) before the output trips; above the inrush limit it trips at once. 0 = on the first sample.
                        Open load: while the output is on, a current below Min current for Min current time sets the output's Undercurrent flag (a var for logic, keypad LEDs, CAN); the output keeps running. Min current 0 = off.
                        Retries: the reset limit counts every trip, so @CustomPdmSettings.ResetLimitText(3).
                    </MudText>
                    <MudSimpleTable Dense="true" Style="max-width: 760px">
                        <thead><tr><th>Output</th><th>Trip time (ms)</th><th>Min current (A)</th><th>Min current time (ms)</th><th>Reset limit</th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < cpro.OutputProtection.Count && i < Device.Outputs.Count; i++)
                        {
                            var op = cpro.OutputProtection[i];
                            var output = Device.Outputs[i];
                            <tr>
                                <td>@output.Name</td>
                                <td><MudNumericField T="int" @bind-Value="op.TripTime" Min="0" Max="OutputProtection.TripTimeMax" Variant="Variant.Outlined" Margin="Margin.Dense"/></td>
                                <td><MudNumericField T="double" @bind-Value="op.MinCurrent" Min="0" Max="OutputProtection.MinCurrentMax" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense"/></td>
                                <td><MudNumericField T="int" @bind-Value="op.MinCurrentTime" Min="0" Max="OutputProtection.MinCurrentTimeMax" Variant="Variant.Outlined" Margin="Margin.Dense"/></td>
                                <td><MudText Typo="Typo.body2">@CustomPdmSettings.ResetLimitText(output.ResetCountLimit)</MudText></td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                </MudExpansionPanel>
            }
        }

        @* custom-pdm T1: lookup tables, block 0x7E00 + table, device types 14 / 15 only *@
        @if (Device.CustomPdm is { } ctab)
        {
            <MudExpansionPanel Text="@($"Lookup Tables ({ctab.Tables.Count})")">
                <MudText Typo="Typo.caption">
                    Output = straight line between points, held at the first / last Y outside the X range. 2 to 8 points, X rising; otherwise the table outputs 0. Table outputs are vars ("Table n").
                </MudText>
                @for (var n = 0; n < ctab.Tables.Count; n++)
                {
                    var t = ctab.Tables[n];
                    var label = $"Table {n + 1}";
                    <MudPaper Class="pa-2 my-2" Elevation="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudSwitch @bind-Value="t.Enabled" Color="Color.Success" Label="@label"/>
                            <MudText Typo="Typo.body2">Input</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Search"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Style="max-width: 20px"
                                           OnClick="@(() => OpenVariableSelectorAsync(["bool", "int", "float"], v => t.Input = v))">
                            </MudIconButton>
                            <MudText>@GetSelectedVarText(t.Input)</MudText>
                            <MudNumericField T="int" @bind-Value="t.Points" Label="Points" Min="0" Max="LookupTable.MaxPoints" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 100px"/>
                            @if (t.Warning is { } w)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Warning">@w</MudText>
                            }
                        </MudStack>
                        <MudSimpleTable Dense="true">
                            <tbody>
                            <tr>
                                <th>X</th>
                                @for (var i = 0; i < LookupTable.MaxPoints; i++)
                                {
                                    var k = i;
                                    <td><MudNumericField T="double" Value="t.X[k]" ValueChanged="@((double v) => t.X[k] = v)" Disabled="@(k >= t.Points)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 90px"/></td>
                                }
                            </tr>
                            <tr>
                                <th>Y</th>
                                @for (var i = 0; i < LookupTable.MaxPoints; i++)
                                {
                                    var k = i;
                                    <td><MudNumericField T="double" Value="t.Y[k]" ValueChanged="@((double v) => t.Y[k] = v)" Disabled="@(k >= t.Points)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 90px"/></td>
                                }
                            </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                }
            </MudExpansionPanel>
        }
        
        @* Analog Inputs *@
        @if (Device.AnalogInputs.Count > 0)
        {
            <MudExpansionPanel Text="@($"Analog Inputs ({Device.AnalogInputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _analogInputsExpanded = expanded)">
                @if (_analogInputsExpanded)
                {
                    <AnalogInputsGrid Inputs="Device.AnalogInputs"/>
                }
            </MudExpansionPanel>

            @* Rotary Switch *@
            <MudExpansionPanel Text="@($"Rotary Switch ({Device.AnalogInputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _rotarySwitchExpanded = expanded)">
                @if (_rotarySwitchExpanded)
                {
                    <RotarySwitchGrid Inputs="Device.AnalogInputs"/>
                }
            </MudExpansionPanel>
        }

        @* Digital Inputs *@
        @if (Device.DigitalInputs.Count > 0)
        {
            <MudExpansionPanel Text="@($"Digital Inputs ({Device.DigitalInputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _digitalInputsExpanded = expanded)">
                @if (_digitalInputsExpanded)
                {
                    <DigitalInputsGrid Inputs="Device.DigitalInputs"/>
                }
            </MudExpansionPanel>
        }
        
        @* Digital Outputs *@
        @if (Device.DigitalOutputs.Count > 0)
        {
            <MudExpansionPanel Text="@($"Digital Outputs ({Device.DigitalOutputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _digitalOutputsExpanded = expanded)">
                @if (_digitalOutputsExpanded)
                {
                    <DigitalOutputsGrid Outputs="Device.DigitalOutputs" Device="Device"/>
                }
            </MudExpansionPanel>
        }
        
        @* CAN Inputs *@
        @if (Device.CanInputs.Count > 0)
        {
            <MudExpansionPanel Text="@($"CAN Inputs ({Device.CanInputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _canInputsExpanded = expanded)">
                @if (_canInputsExpanded)
                {
                    <CanInputsGrid CanInputs="Device.CanInputs" Device="Device" NumCanBuses="Device.Def.NumCanBuses"/>
                }
            </MudExpansionPanel>
        }

        @* CAN Outputs *@
        @if (Device.CanOutputs.Count > 0)
        {
            <MudExpansionPanel Text="@($"CAN Outputs ({Device.CanOutputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _canOutputsExpanded = expanded)">
                @if (_canOutputsExpanded)
                {
                    <CanOutputsGrid CanOutputs="Device.CanOutputs" Device="Device" NumCanBuses="Device.Def.NumCanBuses"/>
                }
            </MudExpansionPanel>
        }

        @* Virtual Inputs *@
        @if (Device.VirtualInputs.Count > 0)
        {
            <MudExpansionPanel Text="@($"Virtual Inputs ({Device.VirtualInputs.Count})")"
                               ExpandedChanged="@((bool expanded) => _virtualInputsExpanded = expanded)">
                @if (_virtualInputsExpanded)
                {
                    <VirtualInputsGrid VirtualInputs="Device.VirtualInputs" Device="Device"/>
                }
            </MudExpansionPanel>
        }

        @* Conditions *@
        @if (Device.Conditions.Count > 0)
        {
            <MudExpansionPanel Text="@($"Conditions ({Device.Conditions.Count})")"
                               ExpandedChanged="@((bool expanded) => _conditionsExpanded = expanded)">
                @if (_conditionsExpanded)
                {
                    <ConditionsGrid Conditions="Device.Conditions" Device="Device"/>
                }
            </MudExpansionPanel>
        }

        @* Counters *@
        @if (Device.Counters.Count > 0)
        {
            <MudExpansionPanel Text="@($"Counters ({Device.Counters.Count})")"
                               ExpandedChanged="@((bool expanded) => _countersExpanded = expanded)">
                @if (_countersExpanded)
                {
                    <CountersGrid Counters="Device.Counters" Device="Device"/>
                }
            </MudExpansionPanel>
        }

        @* Flashers *@
        @if (Device.Flashers.Count > 0)
        {
            <MudExpansionPanel Text="@($"Flashers ({Device.Flashers.Count})")"
                               ExpandedChanged="@((bool expanded) => _flashersExpanded = expanded)">
                @if (_flashersExpanded)
                {
                    <FlashersGrid Flashers="Device.Flashers" Device="Device"/>
                }
            </MudExpansionPanel>
        }

        @* Wiper *@
        @if (Device.Def.HasWipers)
        {
            <MudExpansionPanel Text="Wiper"
                               ExpandedChanged="@((bool expanded) => _wiperExpanded = expanded)">
                @if (_wiperExpanded)
                {
                    <WiperConfig Wiper="Device.Wipers" Device="Device"/>
                }
            </MudExpansionPanel>
        }

        @* Starter Disable *@
        @if (Device.Def.HasStarterDisable)
        {
            <MudExpansionPanel Text="Starter Disable"
                               ExpandedChanged="@((bool expanded) => _starterDisableExpanded = expanded)">
                @if (_starterDisableExpanded)
                {
                    <StarterDisableConfig StarterDisable="Device.StarterDisable" Device="Device"/>
                }
            </MudExpansionPanel>
        }

        @* Timers *@
        @if (Device.Timers.Count > 0)
        {
            <MudExpansionPanel Text="@($"Timers ({Device.Timers.Count})")"
                               ExpandedChanged="@((bool expanded) => _timersExpanded = expanded)">
                @if (_timersExpanded)
                {
                    <TimersGrid Timers="Device.Timers" Device="Device"/>
                }
            </MudExpansionPanel>
        }

        @* Math *@
        @if (Device.MathBlocks.Count > 0)
        {
            <MudExpansionPanel Text="@($"Math ({Device.MathBlocks.Count})")"
                               ExpandedChanged="@((bool expanded) => _mathExpanded = expanded)">
                @if (_mathExpanded)
                {
                    <MathGrid MathBlocks="Device.MathBlocks" Device="Device"/>
                }
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</div>

@code {
    // Expansion panel state tracking for lazy loading
    private bool _digitalInputsExpanded;
    private bool _analogInputsExpanded;
    private bool _rotarySwitchExpanded;
    private bool _digitalOutputsExpanded;
    private bool _outputsExpanded;
    private bool _outputsPwmExpanded;
    private bool _canInputsExpanded;
    private bool _canOutputsExpanded;
    private bool _virtualInputsExpanded;
    private bool _conditionsExpanded;
    private bool _countersExpanded;
    private bool _flashersExpanded;
    private bool _wiperExpanded;
    private bool _starterDisableExpanded;
    private bool _timersExpanded;
    private bool _mathExpanded;

    private string _baseId = string.Empty;
    
    protected override void OnParametersSet()
    {
        _baseId = Utils.FormatId(Device.BaseId, UserPrefs.Preferences.IdFormat);

        StateHasChanged();
        base.OnParametersSet();
    }
}

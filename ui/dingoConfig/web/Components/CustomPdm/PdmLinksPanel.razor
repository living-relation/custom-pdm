@using application.Services
@using domain.CustomPdm
@using web.Services
@inject PdmOpsService Pdm
@inject NotificationService Notification
@inject IDialogService DialogService

@* custom-pdm route B, phase B4 with the w1 recipe (domain/CustomPdm/PdmLinks.cs): any digital input of the PDM as the
   trigger of any output, with a loss mode per output (off / hold / on / condition; no critical start-up exception,
   DECISIONS 2026-11-16: every linked output stays off until its first frame). A cross-board
   link is one stock CAN input on the output's board on the input board's msg 37 (on / condition: + one virtual input
   and the shared ALIVE / SEEN / LOST of that source board); nothing is set on the input board.
   PC edits only: Write All sends them, Burn keeps them. *@
<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel @bind-Expanded="_open">
        <TitleContent>
            <MudText Typo="Typo.body1">Links: any input switches any output (@_links.Count)</MudText>
        </TitleContent>
        <ChildContent>
            @{
                var busy = Pdm.Ops.Busy;
            }
            @if (_old.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2 pdm-link-old">
                    Old recipe on output(s) @string.Join(", ", _old.Select(l => l.Out.Number)): links made with an older recipe ("on" before
                    w1, or "critical") switch the output ON at power-up before the input board's first frame (up to 0.6 s). Upgrade? (same
                    mode, off until the first frame; Write All sends it)
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="ml-2 pdm-link-upgrade" Disabled="@busy" OnClick="Upgrade">Upgrade</MudButton>
                </MudAlert>
            }
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudSelect T="int?" @bind-Value="_in" Label="Input" Placeholder="Pick an input" Variant="Variant.Outlined" Dense="true"
                           Style="min-width: 260px" Disabled="@busy" Class="pdm-link-in">
                    @foreach (var r in View.Inputs.Where(r => r.Digital != null))
                    {
                        <MudSelectItem T="int?" Value="@((int?)r.Number)">@InText(r)</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.body1">switches</MudText>
                <MudSelect T="int?" Value="_out" ValueChanged="@OutChanged" Label="Output" Placeholder="Pick an output" Variant="Variant.Outlined"
                           Dense="true" Style="min-width: 260px" Disabled="@busy" Class="pdm-link-out">
                    @foreach (var o in View.Outputs)
                    {
                        <MudSelectItem T="int?" Value="@((int?)o.Number)">@OutText(o)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="PdmLinkLoss" @bind-Value="_loss" Label="When the input board's message stops" Variant="Variant.Outlined"
                           Dense="true" Style="min-width: 280px" Disabled="@(busy || !CrossBoardChoice)" Class="pdm-link-loss">
                    @foreach (var l in PdmLinks.LossChoices)
                    {
                        <MudSelectItem T="PdmLinkLoss" Value="@l">@PdmLinks.LossName(l)</MudSelectItem>
                    }
                </MudSelect>
                @if (_loss == PdmLinkLoss.Condition && CrossBoardChoice)
                {
                    <MudSelect T="int?" @bind-Value="_cond" Label="Condition" Placeholder="Pick a condition" Variant="Variant.Outlined" Dense="true"
                               Style="min-width: 240px" Disabled="@(busy || _out == null)" Class="pdm-link-cond">
                        @foreach (var c in PdmLinks.CondChoices(View, _out ?? 0))
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.Var)">@c.Text</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Link"
                           Disabled="@(busy || _in == null || _out == null)" OnClick="Add" Class="pdm-link-add">Add link</MudButton>
            </MudStack>
            <MudText Typo="Typo.caption" Style="display: block" Class="mt-1">
                Same board: the output uses the input directly. Other board: one CAN input on the OUTPUT's board listens to the
                input board's status message 37 (every 100 ms); nothing changes on the input board. When that message stops, each
                output does what its mode says after its loss delay (per output, default 1 s, 0.3 to 10 s): off, hold (keeps its last state), on, or condition (follows a
                chosen input / condition of the output's board). After power-up every linked output stays off until the input board's
                first frame (no exception). Hold is off at
                power-up (nothing to remember). Links are PC edits: Write All sends them, Burn keeps them, Read All shows them again.
            </MudText>

            @if (_links.Count > 0)
            {
                <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                    <thead>
                    <tr><th>Output</th><th>Input</th><th>When the message stops</th><th>Condition</th><th>Uses</th><th>Check</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var l in _links)
                    {
                        var link = l;
                        var mode = RowMode(link);
                        <tr class="pdm-link-row">
                            <td>@OutText(link.Out)</td>
                            <td>
                                <MudSelect T="int?" Value="@((int?)link.In.Number)" ValueChanged="@(v => SetInput(link, v))" Dense="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@busy" Style="min-width: 220px" Class="pdm-row-in">
                                    @foreach (var r in View.Inputs.Where(r => r.Digital != null))
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)r.Number)">@InText(r)</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td>
                                @if (link.CrossBoard)
                                {
                                    <MudSelect T="PdmLinkLoss" Value="@mode" ValueChanged="@(v => SetMode(link, v))" Dense="true"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@busy" Style="min-width: 240px" Class="pdm-row-loss">
                                        @foreach (var c in PdmLinks.LossChoices)
                                        {
                                            <MudSelectItem T="PdmLinkLoss" Value="@c">@PdmLinks.LossName(c)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (link.Loss != PdmLinkLoss.Hold)
                                    {
                                        @* editor2: the loss delay of this output (its link CAN input's time-out) *@
                                        <MudNumericField T="int" Value="@link.DelayMs" ValueChanged="@(ms => SetDelay(link, ms))" Label="Loss delay (ms)"
                                                         Min="@PdmLinks.MinDelayMs" Max="@PdmLinks.MaxDelayMs" Step="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Disabled="@busy" Style="max-width: 150px" Class="pdm-row-delay" DebounceInterval="600" />
                                    }
                                    <MudText Typo="Typo.caption">@link.LossText</MudText>
                                }
                                else
                                {
                                    @link.LossText
                                }
                            </td>
                            <td>
                                @if (link.CrossBoard && mode == PdmLinkLoss.Condition)
                                {
                                    <MudSelect T="int?" Value="@(link.Cond == 0 ? null : link.Cond)" ValueChanged="@(v => SetCond(link, v))" Placeholder="Pick a condition"
                                               Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@busy" Style="min-width: 220px" Class="pdm-row-cond">
                                        @foreach (var c in PdmLinks.CondChoices(View, link.Out.Number))
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)c.Var)">@c.Text</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@link.SlotText</td>
                            <td>
                                @foreach (var w in PdmLinks.Warnings(link))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Warning">@w</MudText>
                                }
                            </td>
                            <td>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" Disabled="@busy"
                                           OnClick="@(() => Remove(link))">Remove</MudButton>
                            </td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            }

            <MudText Typo="Typo.body2" Class="mt-3"><b>CAN inputs and virtual inputs per board</b> (32 / 16 each; used on the OUTPUT's board)</MudText>
            @foreach (var b in _slots)
            {
                <MudText Typo="Typo.body2" Class="mt-1 pdm-slot-summary">@b.Summary</MudText>
                @foreach (var u in b.CanInputs.Where(u => !u.Free))
                {
                    <MudText Typo="Typo.caption" Style="display: block; margin-left: 16px">CAN input @(u.Slot + 1): @u.UsedBy</MudText>
                }
                @foreach (var u in b.VirtualInputs.Where(u => !u.Free))
                {
                    <MudText Typo="Typo.caption" Style="display: block; margin-left: 16px">Virtual input @(u.Slot + 1): @u.UsedBy</MudText>
                }
            }
            @if (_slots.Any(b => b.CanInputs.Concat(b.VirtualInputs).Any(u => u.Unused)))
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-1" Disabled="@Pdm.Ops.Busy" OnClick="RemoveUnused">Remove unused link slots</MudButton>
            }
            <MudText Typo="Typo.caption" Style="display: block" Class="mt-1">
                Cost on the output's board: each link 1 CAN input (+ 1 virtual input for on / condition); each input board that has
                on / condition links there 2 shared CAN inputs (ALIVE: its message 37 heard in the last 1 s; SEEN: heard since
                power-up) + 1 shared virtual input (LOST = SEEN AND NOT ALIVE), freed with the last of those links. Only inputs whose
                every field matches these patterns count as links; anything set by hand, A2's fan inputs (CAN 25-28, virtual 12-14)
                and the load-shed virtual inputs 15-16 are never changed here.
            </MudText>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public PdmView View { get; set; } = null!;

    private bool _open = true;
    private int? _in, _out, _cond;
    private PdmLinkLoss _loss = PdmLinks.DefaultLoss;
    private IReadOnlyList<PdmLink> _links = [];
    private IReadOnlyList<PdmLink> _old = [];
    private IReadOnlyList<PdmBoardSlots> _slots = [];
    private readonly HashSet<int> _wantCond = [];   // rows switched to 'condition' that still need their condition picked

    // the page re-renders this 10 times a second: the links are read from the boards' params each time
    protected override void OnParametersSet()
    {
        _links = PdmLinks.Links(View);
        _old = _links.Where(l => l.OldRecipe).ToList();
        _slots = PdmLinks.Slots(View);
        _wantCond.RemoveWhere(o => _links.All(l => l.Out.Number != o || !l.CrossBoard));
    }

    private bool CrossBoardChoice =>
        View.Inputs.FirstOrDefault(r => r.Number == _in) is not { } i || View.Outputs.FirstOrDefault(o => o.Number == _out) is not { } o
        || i.Board != o.Board;

    private PdmLinkLoss RowMode(PdmLink l) => _wantCond.Contains(l.Out.Number) ? PdmLinkLoss.Condition : l.Loss ?? PdmLinks.DefaultLoss;

    private static string InText(PdmInputRow r) => $"{r.Number}: {r.Board} IN{r.BoardInput} ({r.Connector}) {r.Name}";
    private static string OutText(PdmOutputRow o) => $"{o.Number}: {o.Board} OUT{o.BoardOutput} ({o.Connector}) {o.Output.Name}";

    private void Refresh() => OnParametersSet();

    private void OutChanged(int? o)
    {
        _out = o;
        _cond = null; // the condition list is the output board's
    }

    private async Task Add()
    {
        if (_in is not { } input || _out is not { } output) return;
        var overwrite = false;
        if (PdmLinks.Conflict(View, output) is { } taken)
        {
            // DECISIONS g1: never replace a trigger without asking
            var yes = await DialogService.ShowMessageBox("Already assigned", $"{taken} Overwrite?", yesText: "Overwrite", cancelText: "Cancel");
            if (yes != true) return;
            overwrite = true;
        }
        if (PdmLinks.Add(View, input, output, _loss, _cond ?? 0, overwrite) is { } why) { Notification.NewError($"Link not made: {why}"); return; }
        Refresh();
        var l = _links.FirstOrDefault(x => x.Out.Number == output);
        Notification.NewInfo($"Link input {input} -> output {output} made on the PC ({l?.SlotText}). Write All sends it to the boards.");
    }

    private void Done(string? why, string what)
    {
        if (why != null) { Notification.NewError($"Not changed: {why}"); return; }
        Refresh();
        Notification.NewInfo($"{what}. Write All sends it to the boards.");
    }

    private void SetInput(PdmLink l, int? input)
    {
        if (input is not { } i || i == l.In.Number) return;
        Done(PdmLinks.SetInput(View, l.Out.Number, i), $"Output {l.Out.Number}: input {i}");
    }

    private void SetMode(PdmLink l, PdmLinkLoss loss)
    {
        if (loss == PdmLinkLoss.Condition && l.Loss != PdmLinkLoss.Condition)
        {
            _wantCond.Add(l.Out.Number); // made once its condition is picked
            return;
        }
        _wantCond.Remove(l.Out.Number);
        if (loss == l.Loss) return;
        Done(PdmLinks.SetMode(View, l.Out.Number, loss, loss == PdmLinkLoss.Condition ? l.Cond : 0),
            $"Output {l.Out.Number}: {PdmLinks.LossName(loss)}");
    }

    // editor2: per-output loss delay
    private void SetDelay(PdmLink l, int ms)
    {
        if (ms == l.DelayMs) return;
        Done(PdmLinks.SetDelay(View, l.Out.Number, ms), $"Output {l.Out.Number}: loss delay {PdmLinks.DelayText(ms)}");
    }

    private void SetCond(PdmLink l, int? cond)
    {
        if (cond is not { } c) return;
        _wantCond.Remove(l.Out.Number);
        Done(PdmLinks.SetMode(View, l.Out.Number, PdmLinkLoss.Condition, c), $"Output {l.Out.Number}: condition set");
    }

    private void Remove(PdmLink l)
    {
        if (PdmLinks.Remove(View, l.Out.Number) is { } why) { Notification.NewError(why); return; }
        _wantCond.Remove(l.Out.Number);
        Refresh();
        Notification.NewInfo($"Link to output {l.Out.Number} removed on the PC (what it used is freed, trigger none). Write All sends it to the boards.");
    }

    private async Task Upgrade()
    {
        var outs = string.Join(", ", _old.Select(l => l.Out.Number));
        var yes = await DialogService.ShowMessageBox("Upgrade old links",
            $"Convert the old-recipe links of output(s) {outs} to the current recipe (same mode; off until the first frame after power-up)?",
            yesText: "Upgrade", cancelText: "Cancel");
        if (yes != true) return;
        var fails = PdmLinks.Upgrade(View);
        Refresh();
        if (fails.Count > 0) Notification.NewError($"Not upgraded (kept as they were): {string.Join(" ", fails)}");
        else Notification.NewInfo($"Output(s) {outs} upgraded on the PC. Write All sends it to the boards.");
    }

    private void RemoveUnused()
    {
        var n = PdmLinks.RemoveUnused(View);
        Refresh();
        Notification.NewInfo($"{n} unused link slot(s) / virtual input(s) freed on the PC. Write All sends it to the boards.");
    }
}

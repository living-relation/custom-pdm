@page "/pdm"
@using application.Services
@using domain.CustomPdm
@using domain.Devices.Functions
@using domain.Enums
@using domain.Interfaces
@using web.Services
@inject DeviceManager DeviceManager
@inject PdmOpsService Pdm
@inject ICommsAdapterManager AdapterManager
@inject NotificationService Notification
@implements IDisposable

@* custom-pdm route B (docs/ui-route-b-plan.md): the three boards as one PDM.
   B1: live view. B2: editable settings and ONE Read All / Write All / Burn (domain/CustomPdm/PdmOps.cs).
   B3: "New PDM" (PdmNewProject.razor) and the settings set once for the PDM (PdmSettingsPanel.razor).
   B4: links, any input as the trigger of any output (PdmLinksPanel.razor).
   Editing follows the stock grids (Devices/FwDevice/Functions/OutputsGrid.razor, DigitalInputsGrid.razor): same
   clamps, same "disabled when not enabled / paired" rules. *@
<PageTitle>PDM</PageTitle>
@* uiwalk: the two grids fit a 1920 px window. Measured in the browser at 1920 px: the Outputs grid was 2870 px wide
   (HorizontalScrollbar makes the table as wide as its widest one-line content: 40 px of padding, a one-line title
   and a sort button per column); with these rules it is 1612 px = the page width, every column in view. A narrower
   window scrolls sideways as before. Sorting still works with a click on a title. *@
<style>
    .pdm-grid { overflow-x: auto; }
    .pdm-grid .mud-table-cell { padding: 4px 6px !important; }
    .pdm-grid th .sortable-column-header { white-space: normal; line-height: 1.2; }
    .pdm-grid th .column-options { display: none !important; }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (!_view.Any)
    {
        <MudAlert Severity="Severity.Info">
            No custom-pdm boards in the project. Add the devices "custom-pdm A" (twice) and "custom-pdm B" on the Devices page.
        </MudAlert>
        <PdmNewProject />
    }
    else
    {
        var busy = Pdm.Ops.Busy;
        var readBlocked = Pdm.BlockedReason(PdmOpKind.ReadAll, _view, AdapterManager.IsConnected);
        var writeBlocked = Pdm.BlockedReason(PdmOpKind.WriteAll, _view, AdapterManager.IsConnected);
        var burnBlocked = Pdm.BlockedReason(PdmOpKind.Burn, _view, AdapterManager.IsConnected);
        var results = Pdm.Ops.Results;

        @foreach (var problem in _view.Problems)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@problem</MudAlert>
        }

        @* uiwalk: a board that is missing on the bus is said at the top, not only on its card *@
        @if (PdmPageText.OfflineLine(_view, AdapterManager.IsConnected) is { } offline)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" id="pdm-offline">@offline</MudAlert>
        }

        @* p2a: a board connected while the PC holds unsaved edits for it (domain/CustomPdm/PdmAutoRead.cs)
           uiwalk: several boards asking at once (New PDM with the PDM on the bus) is ONE question for the PDM *@
        var asks = Pdm.ConnectAsks().Where(a => PdmPageText.AskNow(a.Role, busy, results)).ToList();
        @if (asks.Count > 1)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2" id="connect-ask-all">
                <MudText Typo="Typo.body2">
                    <b>@PdmPageText.ConnectAskText(asks.Select(a => a.Role).ToList(), asks.All(a => a.Device.CustomPdm?.FactoryNew == true && !a.Device.FullReadDone))</b>
                </MudText>
                <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" id="connect-keep-all"
                               OnClick="@(() => AnswerAll(asks, PdmConnectAnswer.KeepPc))">Keep PC settings (Write All later)</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" id="connect-take-all"
                               OnClick="@(() => AnswerAll(asks, PdmConnectAnswer.TakeBoard))">Take the boards' settings (Read All)</MudButton>
                </MudStack>
            </MudAlert>
        }
        @foreach (var ask in asks.Count > 1 ? [] : asks)
        {
            var dev = ask.Device;
            <MudAlert Severity="Severity.Warning" Class="mb-2" id="@($"connect-ask-{ask.Role}")">
                <MudText Typo="Typo.body2">
                    <b>@ask.Role connected.</b>
                    @(dev.CustomPdm?.FactoryNew == true && !dev.FullReadDone
                        ? "The PC holds the New PDM settings for it, not written yet."
                        : "The PC has changes for it that are not on the board yet.")
                    Which settings do you want?
                </MudText>
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => Pdm.AnswerConnect(dev, PdmConnectAnswer.KeepPc))">Keep PC settings (Write All later)</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="@(() => Pdm.AnswerConnect(dev, PdmConnectAnswer.TakeBoard))">Take the board's (Read All of @ask.Role)</MudButton>
                </MudStack>
            </MudAlert>
        }
        @if (busy && Pdm.ConnectWaiting() is { Count: > 0 } waiting)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Read on connect of @string.Join(", ", waiting.Select(b => b.Role)) waits until the running @OpName(Pdm.Ops.LastOp) ends.
            </MudAlert>
        }

        <MudPaper Outlined="true" Class="pa-3 mb-4">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@(readBlocked != null)" OnClick="@(() => Start(PdmOpKind.ReadAll))">Read All</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Upload"
                           Disabled="@(writeBlocked != null)" OnClick="@(() => Start(PdmOpKind.WriteAll))">Write All</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(burnBlocked != null)" OnClick="@(() => Start(PdmOpKind.Burn))">Burn</MudButton>
                <DbcExportButton View="@_view" />
                @* editor1 (g1): the raw per-board pages, not the normal way in *@
                <MudSpacer />
                <MudTooltip Text="Raw settings of one board (stock pages). Every change there is checked first; critical settings stay locked.">
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune" Href="pdm/advanced" id="pdm-advanced">Advanced (per board)</MudButton>
                </MudTooltip>
                @if (busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <MudText Typo="Typo.body2">@RunName() running: boards are handled one after another (A1, A2, B). Settings are locked until it ends.</MudText>
                }
            </MudStack>
            @if (!busy)
            {
                @foreach (var off in PdmPageText.OffLines(readBlocked, writeBlocked, burnBlocked))
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning" Class="mt-2 pdm-off-line">@off</MudText>
                }
            }
            <MudText Typo="Typo.caption" Class="mt-2" Style="display: block">
                Write All changes the running settings only. Burn is never automatic: it is its own button, it first checks that all
                three boards hold exactly the PC settings (one mismatch: nothing is burned), and each board answers with its own burn result.
                Names are kept in the project file only, not on the boards.
                A board that connects is read by itself (Read on connect); when the PC has changes for it that are not on the board, you are asked first.
            </MudText>
            @if (Pdm.Ops.LastOp != null && results.Count > 0)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body2"><b>@RunName()</b> @(busy ? "(running)" : "(last run)")</MudText>
                @foreach (var r in results)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Style="min-width: 44px;" Color="@ResultColor(r.State)">@r.Role</MudChip>
                        <MudText Typo="Typo.body2">@r.Text@(r.State == PdmStepState.Running && Pdm.Ops.Running(DateTime.UtcNow) is { } run && run.Role == r.Role ? $" {PdmOps.ElapsedText(run.For)}" : "")</MudText>
                    </MudStack>
                }
                @if (busy && Pdm.Ops.LastOp == PdmOpKind.WriteAll)
                {
                    <MudText Typo="Typo.caption" Style="display: block" Class="mt-1">A real board takes about 5 s per Write All (PdmOps.cs); the simulated boards are much slower (40 s to 4 min each seen).</MudText>
                }
                @* uiwalk: a read on connect right after a Write All / Burn must not hide how that run ended *@
                @if (Pdm.Ops.Earlier is { } earlier)
                {
                    <MudText Typo="Typo.body2" Class="mt-2" id="pdm-earlier-run">
                        <b>@OpName(earlier.Op)</b> (the run before): @string.Join("; ", earlier.Results.Select(r => $"{r.Role} {r.Text}"))
                    </MudText>
                }
                @if (!busy && Pdm.Ops.LastOp == PdmOpKind.WriteAll && results.Any(r => r.State != PdmStepState.Ok))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                        The boards are NOT all on the PC settings (see the lines above). Fix the cause, then Write All again.
                    </MudAlert>
                }
                @if (!busy && Pdm.Ops.LastOp == PdmOpKind.Burn && results.Any(r => r.State != PdmStepState.Ok))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                        Not every board is burned (see the lines above). A board that is not burned starts with its old burned settings at the next power-up.
                    </MudAlert>
                }
            }
        </MudPaper>

        <PdmSettingsPanel View="@_view" />
        <PdmTriggersPanel View="@_view" />
        <PdmLinksPanel View="@_view" />
        <PdmFunctionsPanel View="@_view" />
        <PdmValuesPanel View="@_view" />

        <MudText Typo="Typo.h6" Class="mb-2">Boards</MudText>
        <MudGrid Class="mb-4">
            <MudItem>
                <MudCard Style="height: 100%">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@_view.TotalCurrent.ToString("F1") A</MudText>
                        <MudText Typo="Typo.body2">PDM Total Current</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            @foreach (var board in _view.Boards)
            {
                var dev = board.Device;
                <MudItem>
                    <MudCard Style="height: 100%">
                        <MudCardContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.h6">@board.Role</MudText>
                                <MudLink Href="@($"device/{dev.Guid}")" Typo="Typo.body2">@dev.Name (0x@(dev.BaseId.ToString("X")))</MudLink>
                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
                                         Color="@(dev.Connected ? Color.Success : Color.Default)">
                                    @(dev.Connected ? "Connected" : "Offline")
                                </MudChip>
                                @if (!dev.FullReadDone && dev.CustomPdm?.FactoryNew == true)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info">New PDM: factory settings, not read</MudChip>
                                }
                                else if (!dev.FullReadDone)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info">Not read yet: settings are PC defaults</MudChip>
                                }
                                else if (dev.ConfigMismatch)
                                {
                                    <MudTooltip Text="As of the last config check (after connect, Read All, Write All, or the check before a burn). Edits made on the PC since then are not in it.">
                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning">Config Mismatch</MudChip>
                                    </MudTooltip>
                                }
                                @if (Pdm.AutoReader.HasEdits(dev))
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning">PC changes not written</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.body2">
                                @dev.BatteryVoltage.ToString("F1") V &nbsp; @dev.TotalCurrent.ToString("F1") A &nbsp;
                                board @dev.BoardTempC.ToString("F1") &deg;C &nbsp; chip @(dev.CustomPdm?.DieTempC.ToString("F1")) &deg;C
                            </MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-1">
                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
                                         Color="@(dev.CustomPdm?.OverWarn == true ? Color.Warning : Color.Default)">Over Warn</MudChip>
                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
                                         Color="@(dev.CustomPdm?.CriticalSoon == true ? Color.Warning : Color.Default)">Critical Soon</MudChip>
                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
                                         Color="@(dev.CustomPdm?.Critical == true ? Color.Error : Color.Default)">Critical</MudChip>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mb-2">Outputs (@_view.Outputs.Count)</MudText>
        @if (_view.OverRating is { Count: > 0 } over)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                @(over.Count == 1 ? over[0].RatingWarning
                    : $"{over.Count} outputs have a current limit above their rating: {string.Join(", ", over.Select(o => o.Number))}.")
            </MudAlert>
        }
        <MudDataGrid Items="@_view.Outputs" Dense="true" Hover="true" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     SortMode="SortMode.Single" FixedHeader="true" HorizontalScrollbar="false" Height="calc(72vh)" Class="mb-4 pdm-grid">
            <Columns>
                <PropertyColumn Property="x => x.Number" Title="#" Editable="false" />
                @* uiwalk: one "A1 OUT3" column (as the Output triggers list), short titles *@
                <PropertyColumn Property="x => x.BoardOutput" Title="Board output" Editable="false" SortBy="@(x => x.Number)">
                    <CellTemplate><span style="white-space: nowrap" class="@($"pdm-out-where-{context.Item.Number}")">@context.Item.Board OUT@(context.Item.BoardOutput)</span></CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Connector" Title="Pin" Editable="false" />
                <PropertyColumn Property="x => x.RatingA" Title="Rating (A)" Editable="false" />
                <TemplateColumn Title="Enabled" Sortable="true" SortBy="@(x => x.Output.Enabled)">
                    <EditTemplate>
                        <MudCheckBox @bind-Value="context.Item.Output.Enabled" Dense="true" Disabled="@busy" />
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Name" Sortable="true" SortBy="@(x => x.Output.Name)" CellStyle="min-width: 160px">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Output.Name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@busy" />
                    </EditTemplate>
                </TemplateColumn>
                @* editor2: device preset per output (domain/CustomPdm/PdmPresets.cs); every value stays editable *@
                <TemplateColumn Title="Device" Sortable="false" CellStyle="min-width: 210px">
                    <EditTemplate>
                        @{
                            var row = context.Item;
                            var kind = PdmPresets.KindOf(_view, row);
                            var changed = kind == PdmDeviceKind.None ? [] : PdmPresets.Changed(_view, row, kind);
                            var pro = row.Device.CustomPdm?.OutputProtection.ElementAtOrDefault(row.BoardOutput - 1);
                        }
                        <MudSelect T="PdmDeviceKind" Value="@kind" ValueChanged="@(k => ApplyPreset(row, k))" Dense="true" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Disabled="@(busy || PdmTriggers.IsFanOutput(row) || row.Output.PrimaryOutput >= 0)"
                                   Class="@($"pdm-preset pdm-preset-{row.Number}")">
                            <MudSelectItem T="PdmDeviceKind" Value="@PdmDeviceKind.None">(none)</MudSelectItem>
                            @foreach (var p in PdmPresets.All)
                            {
                                <MudSelectItem T="PdmDeviceKind" Value="@p.Kind">@p.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (changed.Count > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="@($"pdm-preset-changed-{row.Number}")">preset changed: @string.Join(", ", changed)</MudChip>
                        }
                        <MudText Typo="Typo.caption" Style="display: block">
                            @PdmPresets.TripsText(row.Output.ResetMode == ResetMode.None ? 1 : row.Output.ResetCountLimit, row.Output.ResetTime)@(pro != null ? $"; trip {pro.TripTime} ms{(pro.MinCurrent > 0 ? $"; open-load below {pro.MinCurrent:0.##} A" : "")}" : "")
                        </MudText>
                    </EditTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Output.State" Title="State" Editable="false">
                    <CellTemplate>
                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Style="min-width: 50px;"
                                 Color="@GetOutputColor(context.Item.Output.State)">
                            @GetOutputStateText(context.Item.Output.State)
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Output.Current" Title="Current (A)" Editable="false" Format="F1" />
                <TemplateColumn Title="Current Limit (A)" Sortable="true" SortBy="@(x => x.Output.CurrentLimit)" CellStyle="min-width: 100px">
                    <EditTemplate>
                        <MudNumericField Style="width: 92px" @key="@($"currentLimit-{context.Item.Number}-{_refreshCounter}")"
                                         Value="@context.Item.Output.CurrentLimit" Disabled="@Locked(context.Item.Output)"
                                         Error="@context.Item.OverRating" ErrorText="Above rating"
                                         ValueChanged="@((double val) => OnCurrentLimitChanged(context.Item, val))" />
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Inrush Limit (A)" Sortable="true" SortBy="@(x => x.Output.InrushCurrentLimit)" CellStyle="min-width: 100px">
                    <EditTemplate>
                        <MudNumericField Style="width: 92px" @key="@($"inrushLimit-{context.Item.Number}-{_refreshCounter}")"
                                         Value="@context.Item.Output.InrushCurrentLimit" Disabled="@Locked(context.Item.Output)"
                                         ValueChanged="@((double val) => OnInrushLimitChanged(context.Item.Output, val))" />
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Inrush Time (ms)" Sortable="true" SortBy="@(x => x.Output.InrushTime)" CellStyle="min-width: 100px">
                    <EditTemplate>
                        <MudNumericField Style="width: 92px" @key="@($"inrushTime-{context.Item.Number}-{_refreshCounter}")"
                                         Value="@context.Item.Output.InrushTime" Disabled="@Locked(context.Item.Output)"
                                         ValueChanged="@((int val) => OnInrushTimeChanged(context.Item.Output, val))" />
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Reset Mode" Sortable="true" SortBy="@(x => (int)x.Output.ResetMode)" CellStyle="min-width: 104px">
                    <EditTemplate>
                        <MudSelect T="ResetMode" @bind-Value="context.Item.Output.ResetMode" Variant="Variant.Outlined" Dense="true" Style="width: 104px"
                                   Disabled="@Locked(context.Item.Output)">
                            @foreach (ResetMode resetMode in Enum.GetValues(typeof(ResetMode)))
                            {
                                <MudSelectItem T="ResetMode" Value="@resetMode">@resetMode</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Reset Count Limit" Sortable="true" SortBy="@(x => x.Output.ResetCountLimit)" CellStyle="min-width: 80px">
                    <EditTemplate>
                        <MudNumericField Style="width: 92px" @key="@($"resetCount-{context.Item.Number}-{_refreshCounter}")"
                                         Value="@context.Item.Output.ResetCountLimit" Disabled="@Locked(context.Item.Output)"
                                         ValueChanged="@((int val) => OnResetCountChanged(context.Item.Output, val))" />
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Reset Time (ms)" Sortable="true" SortBy="@(x => x.Output.ResetTime)" CellStyle="min-width: 100px">
                    <EditTemplate>
                        <MudNumericField Style="width: 92px" @key="@($"resetTime-{context.Item.Number}-{_refreshCounter}")"
                                         Value="@context.Item.Output.ResetTime" Disabled="@Locked(context.Item.Output)"
                                         ValueChanged="@((int val) => OnResetTimeChanged(context.Item.Output, val))" />
                    </EditTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Output.ResetCount" Title="Reset Count" Editable="false" />
            </Columns>
        </MudDataGrid>

        <MudText Typo="Typo.h6" Class="mb-2">Inputs (@_view.Inputs.Count)</MudText>
        <MudDataGrid Items="@_view.Inputs" Dense="true" Hover="true" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     SortMode="SortMode.Single" FixedHeader="true" HorizontalScrollbar="false" Height="calc(72vh)" Class="mb-4 pdm-grid">
            <Columns>
                <PropertyColumn Property="x => x.Number" Title="#" Editable="false" />
                <PropertyColumn Property="x => x.BoardInput" Title="Board input" Editable="false" SortBy="@(x => x.Number)">
                    <CellTemplate><span style="white-space: nowrap">@context.Item.Board @(context.Item.Kind == "Analog" ? "AN" : "IN")@(context.Item.BoardInput)</span></CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Kind" Title="Kind" Editable="false" />
                <PropertyColumn Property="x => x.Connector" Title="Pin" Editable="false" />
                <TemplateColumn Title="Enabled" Sortable="true" SortBy="@(x => x.Enabled)">
                    <EditTemplate>
                        @if (context.Item.Digital is { } di)
                        {
                            <MudCheckBox @bind-Value="di.Enabled" Dense="true" Disabled="@busy" />
                        }
                        else
                        {
                            @(context.Item.Enabled ? "Yes" : "No")
                        }
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Name" Sortable="true" SortBy="@(x => x.Name)" CellStyle="min-width: 160px">
                    <EditTemplate>
                        @if (context.Item.Digital is { } di)
                        {
                            <MudTextField @bind-Value="di.Name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@busy" />
                        }
                        else
                        {
                            @context.Item.Name
                        }
                    </EditTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Value" Title="State / Value" Editable="false">
                    <CellTemplate>
                        @if (context.Item.Digital is { } di)
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Style="min-width: 50px;"
                                     Color="@(di.State ? Color.Success : Color.Default)">@(di.State ? "ON" : "OFF")</MudChip>
                        }
                        else if (context.Item.Analog is { } an)
                        {
                            @($"{an.Millivolts:F0} mV")
                        }
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="Mode" Sortable="true" SortBy="@(x => x.Digital == null ? -1 : (int)x.Digital.Mode)" CellStyle="min-width: 140px">
                    <EditTemplate>
                        @if (context.Item.Digital is { } di)
                        {
                            <MudSelect T="domain.Enums.InputMode" @bind-Value="di.Mode" Variant="Variant.Outlined" Dense="true" Disabled="@Locked(di)">
                                @foreach (domain.Enums.InputMode mode in Enum.GetValues(typeof(domain.Enums.InputMode)))
                                {
                                    <MudSelectItem T="domain.Enums.InputMode" Value="@mode">@mode</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Pull" Sortable="true" SortBy="@(x => x.Digital == null ? -1 : (int)x.Digital.Pull)" CellStyle="min-width: 140px">
                    <EditTemplate>
                        @if (context.Item.Digital is { } di)
                        {
                            <MudSelect T="InputPull" @bind-Value="di.Pull" Variant="Variant.Outlined" Dense="true" Disabled="@Locked(di)">
                                @foreach (InputPull pull in Enum.GetValues(typeof(InputPull)))
                                {
                                    <MudSelectItem T="InputPull" Value="@pull">@pull</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Invert" Sortable="true" SortBy="@(x => x.Digital != null && x.Digital.Invert)">
                    <EditTemplate>
                        @if (context.Item.Digital is { } di)
                        {
                            <MudCheckBox @bind-Value="di.Invert" Dense="true" Disabled="@Locked(di)" />
                        }
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Debounce (ms)" Sortable="true" SortBy="@(x => x.Digital == null ? -1 : x.Digital.DebounceTime)" CellStyle="min-width: 100px">
                    <EditTemplate>
                        @if (context.Item.Digital is { } di)
                        {
                            <MudNumericField Style="width: 92px" @key="@($"debounce-{context.Item.Number}-{_refreshCounter}")"
                                             Value="@di.DebounceTime" Disabled="@Locked(di)"
                                             ValueChanged="@((int val) => OnDebounceChanged(di, val))" />
                        }
                    </EditTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
        <MudText Typo="Typo.caption">Analog inputs (rows 25-27) are read-only here: set them on the board's own page.</MudText>
    }
</MudContainer>

@code {
    private PdmView _view = new();
    private Timer? _refreshTimer;
    private int _refreshCounter;

    protected override void OnInitialized()
    {
        _view = Pdm.BuildView();

        // Live refresh at 10 Hz. The rows are rebuilt only when the boards change (PdmView.SameBoards): a rebuild
        // on every tick would recreate every row and throw away the cell being edited.
        _refreshTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                var fresh = Pdm.BuildView();
                if (!fresh.SameBoards(_view)) _view = fresh;
                StateHasChanged();
            });
        }, null, TimeSpan.FromMilliseconds(100), TimeSpan.FromMilliseconds(100));
    }

    private void Start(PdmOpKind op)
    {
        try
        {
            var refused = Pdm.Start(op, AdapterManager.IsConnected);
            if (refused != null) Notification.NewError($"PDM {OpName(op)} not started: {refused}");
            else Notification.NewInfo($"PDM {OpName(op)} started (A1, A2, B)");
        }
        catch (Exception ex)
        {
            Notification.NewError($"Error starting PDM {OpName(op)}", ex);
        }
    }

    private static string OpName(PdmOpKind? op) => op switch
    {
        PdmOpKind.ReadAll => "Read All",
        PdmOpKind.WriteAll => "Write All",
        PdmOpKind.Burn => "Burn",
        _ => ""
    };

    private void AnswerAll(IReadOnlyList<PdmBoard> asks, PdmConnectAnswer answer)
    {
        foreach (var b in asks) Pdm.AnswerConnect(b.Device, answer);
    }

    // p2a: a Read All started by a board that connected (PdmAutoRead)
    private string RunName() => Pdm.Ops.LastOnConnect ? "Read on connect" : OpName(Pdm.Ops.LastOp);

    private static Color ResultColor(PdmStepState state) => state switch
    {
        PdmStepState.Ok => Color.Success,
        PdmStepState.Failed => Color.Error,
        PdmStepState.NotDone => Color.Warning,
        PdmStepState.Running => Color.Info,
        _ => Color.Default
    };

    // Stock rules (OutputsGrid / DigitalInputsGrid), plus: locked while a PDM run is active
    private bool Locked(Output o) => Pdm.Ops.Busy || !o.Enabled || o.PrimaryOutput >= 0;
    private bool Locked(DigitalInput i) => Pdm.Ops.Busy || !i.Enabled;

    // editor2: fill the output from a device preset (PdmPresets); the notes say what else it did
    private void ApplyPreset(PdmOutputRow row, PdmDeviceKind k)
    {
        var notes = new List<string>();
        if (PdmPresets.Apply(_view, row.Number, k, notes) is { } why)
        {
            Notification.NewError($"Preset not applied: {why}");
            return;
        }
        _refreshCounter++;
        if (k != PdmDeviceKind.None)
            Notification.NewInfo($"Output {row.Number}: {PdmPresets.Of(k).Name} ({PdmPresets.Of(k).Why}){(notes.Count > 0 ? "; " + string.Join("; ", notes) : "")}. Write All sends it to the boards.");
    }

    // Same limits and messages as the stock grids
    private void OnCurrentLimitChanged(PdmOutputRow row, double value)
    {
        row.Output.CurrentLimit = Clamp(value, 0, 100.0, $"{row.Output.Name}.CurrentLimit");
        if (row.RatingWarning is { } warn) Notification.NewWarning(warn); // b2b: allowed, but warned
    }

    private void OnInrushLimitChanged(Output item, double value) =>
        item.InrushCurrentLimit = Clamp(value, 0, 100.0, $"{item.Name}.InrushCurrentLimit");

    private void OnInrushTimeChanged(Output item, int value) =>
        item.InrushTime = (int)Clamp(value, 0, 10000, $"{item.Name}.InrushTime");

    private void OnResetCountChanged(Output item, int value) =>
        item.ResetCountLimit = (int)Clamp(value, 0, 20, $"{item.Name}.ResetCountLimit");

    private void OnResetTimeChanged(Output item, int value) =>
        item.ResetTime = (int)Clamp(value, 0, 60000, $"{item.Name}.ResetTime");

    private void OnDebounceChanged(DigitalInput item, int value) =>
        item.DebounceTime = (int)Clamp(value, 0, 1000, $"{item.Name}.DebounceTime");

    private double Clamp(double value, double min, double max, string what)
    {
        if (value < min || value > max) Notification.NewWarning($"{what} must be {min} to {max}");
        _refreshCounter++;
        return Math.Clamp(value, min, max);
    }

    private static Color GetOutputColor(OutState state) => state switch
    {
        OutState.On => Color.Success,
        OutState.Overcurrent => Color.Warning,
        OutState.Fault => Color.Error,
        _ => Color.Default
    };

    private static string GetOutputStateText(OutState state) => state switch
    {
        OutState.On => "ON",
        OutState.Overcurrent => "OVERCURRENT",
        OutState.Fault => "FAULT",
        _ => "OFF"
    };

    public void Dispose() => _refreshTimer?.Dispose();
}

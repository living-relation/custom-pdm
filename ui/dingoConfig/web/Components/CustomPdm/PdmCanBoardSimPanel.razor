@using application.Services
@using domain.CustomPdm
@using web.Services
@inject PdmSimService Sim
@inject NotificationService Notification

@* custom-pdm canboard (domain/CustomPdm/PdmCanBoardSim.cs): a simulated CANBoard for every CANBoard of the setup,
   inside the /pdm Simulator panel. It sends the CANBoard's real status frames (the bridge's stand-in, sim_bridge.py
   class CanBoard); the switches / sliders set what would be wired to it, the lamps show what it reports for its 4
   outputs. Everything shown is read from the frames on the bus. *@
@{
    var all = PdmCanBoard.All(View);
    Sim.Watch(all.Select(c => c.BaseId));
}
@foreach (var cb in all)
{
    var c = cb;
    var live = Sim.CanBoard(c.BaseId);
    if (live.Alive && Sim.SyncCanBoard(c) is { } syncRefused) { _note = syncRefused; }
    <MudPaper Outlined="true" Class="pa-2 mt-3" id="@($"pdm-sim-cb-{c.BaseId:X}")">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2"><b>Simulated CANBoard: @c.Name</b> (0x@(c.BaseId.ToString("X3")))</MudText>
            <MudChip T="string" Size="Size.Small" Color="@(live.Alive ? Color.Success : Color.Default)" Variant="Variant.Outlined" Class="pdm-sim-cb-state">
                @(live.Alive ? "on the bus" : "not on the bus (silent)")
            </MudChip>
            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" Class="pdm-sim-cb-plug" OnClick="@(() => Plug(c))">@(live.Alive ? "Plug in again" : "Plug in")</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="pdm-sim-cb-unplug" Disabled="@(!live.Alive)"
                       OnClick="@(() => Send(PdmCanBoardSim.LinkLine(c.BaseId, false), $"{c.Name} unplugged: its inputs go off after {PdmLinks.DelayText(c.TimeoutMs)}"))">Unplug</MudButton>
        </MudStack>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-1">
            <MudText Typo="Typo.body2" Style="min-width: 80px">Switches</MudText>
            @for (var i = 1; i <= PdmCanBoard.Switches; i++)
            {
                var n = i;
                <MudSwitch T="bool" Value="@live.Switches[n - 1]" ValueChanged="@(on => Send(PdmCanBoardSim.SwitchLine(c.BaseId, n, on), null))" Label="@n.ToString()"
                           Color="Color.Success" Size="Size.Small" Disabled="@(!live.Alive)" Class="@($"pdm-sim-cb-sw pdm-sim-cb-sw-{n}")" />
            }
        </MudStack>
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-1">
            <MudText Typo="Typo.body2" Style="min-width: 80px">Analog</MudText>
            @for (var i = 1; i <= PdmCanBoard.Analogs; i++)
            {
                var n = i;
                <div style="min-width: 150px" class="@($"pdm-sim-cb-an pdm-sim-cb-an-{n}")">
                    <MudSlider T="int" Min="0" Max="@PdmCanBoard.MaxAnalogMv" Step="50" Value="@live.Mv[n - 1]" Size="Size.Small" Disabled="@(!live.Alive)"
                               ValueChanged="@(mv => Send(PdmCanBoardSim.AnalogLine(c.BaseId, n, mv), null))">@n: @live.Mv[n - 1] mV</MudSlider>
                </div>
            }
        </MudStack>
        @if (c.HasRotary)
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-1">
                <MudText Typo="Typo.body2" Style="min-width: 80px">Rotary</MudText>
                @for (var i = 1; i <= PdmCanBoard.Rotaries; i++)
                {
                    var n = i;
                    <MudNumericField T="int" Value="@live.Rotary[n - 1]" ValueChanged="@(p => Send(PdmCanBoardSim.RotaryLine(c.BaseId, n, p), null))" Label="@($"{n}: position")"
                                     Min="0" Max="@PdmCanBoard.MaxRotary" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 110px" Disabled="@(!live.Alive)" Class="pdm-sim-cb-rot" />
                }
            </MudStack>
        }
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-1">
            <MudText Typo="Typo.body2" Style="min-width: 80px">Its outputs</MudText>
            @for (var i = 1; i <= PdmCanBoard.Outs; i++)
            {
                var n = i;
                var on = live.Alive && live.Outputs[n - 1];
                var driven = c.Outputs.Any(o => o.Number == n);
                <MudChip T="string" Size="Size.Small" Color="@(on ? Color.Success : Color.Default)" Variant="@(on ? Variant.Filled : Variant.Outlined)" Class="@($"pdm-sim-cb-out pdm-sim-cb-out-{n}")">
                    @n: @(on ? "ON" : "off")@(driven ? "" : " (follows nothing)")
                </MudChip>
            }
            <MudText Typo="Typo.caption">as the CANBoard reports them; it is set as the CANBoard card says (after Write All the PDM sends the frames).</MudText>
        </MudStack>
    </MudPaper>
}
@if (_note != null)
{
    <MudText Typo="Typo.caption" Color="Color.Error">Simulator: @_note</MudText>
}

@code {
    [Parameter, EditorRequired] public PdmView View { get; set; } = null!;

    private string? _note;

    private void Send(string? line, string? done)
    {
        var refused = Sim.Send(line);
        if (refused != null) Notification.NewError($"Simulator: {refused}");
        else if (done != null) Notification.NewInfo($"Simulator: {done}");
    }

    private void Plug(PdmCanBoardInfo c)
    {
        _note = null;
        var refused = Sim.PlugCanBoard(c);
        if (refused != null) Notification.NewError($"Simulator: {refused}");
        else Notification.NewInfo($"Simulator: {c.Name} is on the bus (it sends its frames every {PdmCanBoard.PeriodMs} ms)");
    }
}

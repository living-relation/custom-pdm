@using application.Services
@using domain.CustomPdm
@using web.Services
@inject PdmOpsService Pdm
@inject NotificationService Notification
@inject ConfigFileManager Files
@inject DeviceManager Devices
@inject IWebHostEnvironment Env

@* custom-pdm route B, phase B3 (u2a): "New PDM" adds A1, A2, B with our firmware's factory defaults
   (domain/CustomPdm/PdmFactoryDefaults.cs, proven equal to fresh boards against the firmware sim). *@
<MudPaper Outlined="true" Class="pa-3 mt-2">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddBox"
                   Disabled="@Pdm.Ops.Busy" OnClick="@Create">New PDM</MudButton>
        <MudText Typo="Typo.body2">
            Adds A1 (0x@(PdmFactoryDefaults.BaseA1.ToString("X3"))), A2 (0x@(PdmFactoryDefaults.BaseA2.ToString("X3"))) and
            B (0x@(PdmFactoryDefaults.BaseB.ToString("X3"))) with our firmware's factory settings (1000K, fans on A2 OUT2
            at @PdmFactoryDefaults.FanOnC.ToString("0") / @PdmFactoryDefaults.FanOffC.ToString("0") &deg;C, limits 55 / 80 &deg;C), not stock dingoPDM ones.
        </MudText>
    </MudStack>
    <MudText Typo="Typo.caption" Style="display: block" Class="mt-1">
        A New PDM project can be written without a Read All first: Write All then REPLACES whatever the boards hold with
        these settings plus your edits. To keep what is on the boards, press Read All first.
    </MudText>
    @* uiwalk: an example to start from (ui/examples, application/Services/PdmStarter.cs) *@
    @if (_starter != null)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.DirectionsCar"
                       Disabled="@Pdm.Ops.Busy" OnClick="@LoadStarter" id="pdm-load-starter">Load the ST185 starter</MudButton>
            <MudText Typo="Typo.body2">
                A New PDM with an example car setup already made (dummy data, not the real car): fans, fuel pump from
                the ECU, lights, horn, turn signals, wiper, an ignition group. Change what you like, then Write All.
            </MudText>
        </MudStack>
    }
    @* carconfig: the install config for the car (ui/examples/st185-car.json), loaded by the same rules as the starter *@
    @if (_car != null)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.CarRepair"
                       Disabled="@Pdm.Ops.Busy" OnClick="@LoadCar" id="pdm-load-car">Load the ST185 car config</MudButton>
            <MudText Typo="Typo.body2">
                The install config for the ST185 (from the st185 car map, docs/st185-car-config.md): lights, horns, the
                ECU's fuel pump, fans and EPS enable, the CAN-Lambda, the A/C clutch and the module feeds. The ECU frame
                0x3F4 is a placeholder until the Link ECU CAN setup is done. Write All, Burn, then check the outputs.
            </MudText>
        </MudStack>
    }
</MudPaper>

@code {
    private string? _starter;
    private string? _car;

    protected override void OnInitialized()
    {
        _starter = PdmStarter.Find(Env.ContentRootPath);
        _car = PdmStarter.Find(Env.ContentRootPath, PdmStarter.CarFileName);
    }

    private async Task LoadCar()
    {
        try
        {
            var refused = await PdmStarter.LoadAsync(_car!, Files, Devices, Pdm.Ops, "car config");
            if (refused != null) Notification.NewError($"Car config not loaded: {refused}");
            else Notification.NewSuccess("ST185 car config loaded: Write All, Burn, then check the outputs (docs/st185-car-config.md)");
        }
        catch (Exception ex)
        {
            Notification.NewError("Error loading the car config", ex);
        }
    }

    private async Task LoadStarter()
    {
        try
        {
            var refused = await PdmStarter.LoadAsync(_starter!, Files, Devices, Pdm.Ops);
            if (refused != null) Notification.NewError($"Starter not loaded: {refused}");
            else Notification.NewSuccess("ST185 starter loaded (a dummy example): look it over, change it, then Write All and Burn");
        }
        catch (Exception ex)
        {
            Notification.NewError("Error loading the starter", ex);
        }
    }

    private void Create()
    {
        var refused = Pdm.NewPdm();
        if (refused != null) Notification.NewError($"New PDM not created: {refused}");
        else
        {
            Pdm.Ops.ClearResults(); // uiwalk: no "read OK" lines of the project before
            Notification.NewSuccess("New PDM: A1, A2 and B added with our factory settings");
        }
    }
}

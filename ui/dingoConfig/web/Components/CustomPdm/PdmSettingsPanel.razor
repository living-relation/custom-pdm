@using application.Services
@using domain.CustomPdm
@using domain.Interfaces
@using web.Services
@inject PdmOpsService Pdm
@inject ICommsAdapterManager AdapterManager
@inject NotificationService Notification
@inject IDialogService DialogService

@* custom-pdm route B, phase B3 (docs/ui-route-b-plan.md): settings set ONCE for the PDM (domain/CustomPdm/PdmLinked.cs).
   Temperature limits and fan thresholds are PC edits: they reach the boards with the Write All above, and stay
   after Burn. Base IDs move the board at once (stock Modify message), see PdmOpsService.ChangeBaseId. *@
<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="PDM settings (set once for A1, A2 and B)" @bind-Expanded="_open">
        @{
            var busy = Pdm.Ops.Busy;
            var a2 = View.Boards.FirstOrDefault(b => b.Role == "A2")?.Device;
        }
        <MudGrid Spacing="4">
            @* ---- temperature limits (u1a; ADR-2026-11-20-temp-onepdm): ONE hot-spot set, converted per board (PdmThermal) ---- *@
            <MudItem>
                <MudCard Elevation="2" Style="height: 100%">
                    <MudCardContent>
                        <MudText Typo="Typo.body1">Board temperature limits (hot spot, one set for the PDM)</MudText>
                        <MudText Typo="Typo.caption" Style="display: block; max-width: 460px" Class="mb-1">
                            Entered as the hottest point of the board (laminate). Each board compares its own sensor, so
                            the tool converts the set per board: board B sensor = hot spot - @(PdmThermal.BoardBOffsetK) K,
                            board A sensor = hot spot - @(PdmThermal.BoardAOffsetK) K (each board's FEA map).
                        </MudText>
                        @if (PdmThermal.Current(View) == null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="my-1">@PdmThermal.NoModelBoard</MudAlert>
                        }
                        <MudNumericField T="int" Value="_warn" ValueChanged="@(v => { _warn = v; _tempDirty = true; })" Label="Warn, hot spot (°C)"
                                         Variant="Variant.Outlined" Style="max-width: 220px" Disabled="@(busy || PdmThermal.Current(View) == null)" id="hot-warn" />
                        @* editor1 (p1 / p3): critical, locked; changes only through Unlock *@
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudTextField T="string" Value="@($"{_crit}")" Label="Critical, all outputs off, hot spot (°C), locked" ReadOnly="true"
                                          Variant="Variant.Outlined" Style="max-width: 220px" id="crit-temp" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(busy || PdmThermal.Current(View) == null)" id="unlock-crit-temp"
                                       OnClick="@(() => Unlock(PdmCriticalKind.CritTemp, ""))">Unlock</MudButton>
                        </MudStack>
                        <MudNumericField T="int" Value="_hyst" ValueChanged="@(v => { _hyst = v; _tempDirty = true; })" Label="Recovery below critical (°C)"
                                         Variant="Variant.Outlined" Style="max-width: 220px" Disabled="@(busy || PdmThermal.Current(View) == null)" />
                        <MudNumericField T="int" Value="_margin" ValueChanged="@(v => { _margin = v; _tempDirty = true; })" Label="Critical-soon margin (°C, 0 = off)"
                                         Variant="Variant.Outlined" Style="max-width: 220px" Disabled="@(busy || PdmThermal.Current(View) == null)" />

                        @* what each board's sensor limit becomes (the values Write All sends) *@
                        <MudText Typo="Typo.body2" Class="mt-2"><b>Each board's sensor limit</b>@(_tempDirty ? " (after Set)" : "")</MudText>
                        <MudSimpleTable Dense="true" Style="max-width: 520px" id="temp-per-board">
                            <thead><tr><th>Board</th><th>Warn</th><th>Critical</th><th>Recovery</th><th>Soon</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var r in PdmThermal.Preview(View, TempInput))
                            {
                                <tr>
                                    <td>@r.Role</td><td style="white-space: nowrap">@r.Sensor.Warn °C</td><td style="white-space: nowrap">@r.Sensor.Crit °C</td><td style="white-space: nowrap">@r.Sensor.Hyst °C</td><td style="white-space: nowrap">@(r.Sensor.Margin == 0 ? "off" : $"{r.Sensor.Margin} °C")</td>
                                    <td><MudText Typo="Typo.caption">@(r.Converted ? $"hot spot - {PdmThermal.OffsetK(View.Boards.Single(b => b.Role == r.Role).Device)} K" : "kept: no thermal model yet")</MudText></td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                        @if (PdmThermal.Current(View) != null && PdmThermal.Problem(View, TempInput) is { } tempWhy)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error">@tempWhy</MudText>
                        }
                        @foreach (var n in PdmThermal.RatingNotes(View, TempInput))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@n</MudAlert>
                        }
                        @foreach (var n in PdmThermal.OffFactory(View))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@n /pdm never puts another board's limits on board A.</MudAlert>
                        }
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(busy || PdmThermal.Problem(View, TempInput) != null)" id="set-temps"
                                       OnClick="SetTemps">Set on A1, A2, B</MudButton>
                            @if (_tempDirty)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _tempDirty = false)">Undo edits</MudButton>
                            }
                            @if (PdmThermal.OffFactory(View).Count > 0)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@busy" id="restore-a-temps" OnClick="RestoreA">Unlock: board A back to factory</MudButton>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* ---- fan thresholds (A2: 6 params that move together) ---- *@
            <MudItem>
                <MudCard Elevation="2" Style="height: 100%">
                    <MudCardContent>
                        <MudText Typo="Typo.body1">Fans (A2 OUT2): on / off on the hottest of A2, A1, B</MudText>
                        @if (a2 == null)
                        {
                            <MudText Typo="Typo.body2">No A2 in the project.</MudText>
                        }
                        else if (PdmLinked.FanLayoutProblem(a2) is { } fanLayoutWhy)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1">@fanLayoutWhy</MudAlert>
                        }
                        else
                        {
                            @if (PdmLinked.FanThresholds(a2) == null)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1">The six fan values on A2 differ. Set once to make them equal.</MudAlert>
                            }
                            <MudNumericField T="double" Value="_fanOn" ValueChanged="@(v => { _fanOn = v; _fanDirty = true; })" Label="Fan on at (°C)"
                                             Variant="Variant.Outlined" Style="max-width: 220px" Disabled="@busy" Step="0.5" />
                            <MudNumericField T="double" Value="_fanOff" ValueChanged="@(v => { _fanOff = v; _fanDirty = true; })" Label="Fan off at or below (°C)"
                                             Variant="Variant.Outlined" Style="max-width: 220px" Disabled="@busy" Step="0.5" />
                            @if (FanInput.Problem() is { } fanWhy)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Error">@fanWhy</MudText>
                            }
                            <MudStack Row="true" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(busy || FanInput.Problem() != null)"
                                           OnClick="@(() => SetFan(a2))">Set on A2</MudButton>
                                @if (_fanDirty)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _fanDirty = false)">Undo edits</MudButton>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption" Style="display: block" Class="mt-1">On A2 now: @string.Join("; ", PdmLinked.FanParamsText(a2)).</MudText>
                            @foreach (var p in PdmLinked.FanRemoteIdProblems(View))
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@p</MudAlert>
                            }
                            @if (PdmLinked.FanRemoteIdProblems(View).Count > 0)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-1" Disabled="@busy"
                                           OnClick="PointFan">Point A2's fan inputs at A1 / B</MudButton>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* ---- base IDs ---- *@
            <MudItem>
                <MudCard Elevation="2" Style="height: 100%">
                    <MudCardContent>
                        <MudText Typo="Typo.body1">Base IDs (one board uses base to base + 0x@((PdmLinked.BlockSize - 1).ToString("X2")))</MudText>
                        @* editor1 (p1 / p3): base IDs are critical: read-only, Unlock + type the new one twice + Change, then Move *@
                        @foreach (var board in View.Boards)
                        {
                            var role = board.Role;
                            var cur = board.Device.BaseId;
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Style="min-width: 150px" id="@($"base-{role}")">@role 0x@(cur.ToString("X3"))-0x@((cur + PdmLinked.BlockSize - 1).ToString("X3"))</MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@busy" id="@($"unlock-base-{role}")"
                                           OnClick="@(() => Unlock(PdmCriticalKind.BaseId, role))">Unlock to move</MudButton>
                            </MudStack>
                        }
                        <MudText Typo="Typo.caption" Style="display: block; max-width: 420px" Class="mt-2">
                            Move is not a Write All value: it sends ONE message to the board now (as Modify on the Devices
                            page) and the board answers on the new ID at once. A2's fan inputs and the link slots that
                            listen to the moved board follow it on the PC.
                            Then press Write All (the other boards learn the new IDs) and Burn: until the Burn, a power cycle puts
                            the board back on its old ID. The ECU needs the new IDs too (DBC).
                        </MudText>
                        @if (_moveDone.Count > 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">@string.Join("; ", _moveDone). Next: Write All, then Burn.</MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* ---- editor1 (p1 / p3): the other critical settings, one value for the PDM, locked ---- *@
            <MudItem>
                <MudCard Elevation="2" Style="height: 100%">
                    <MudCardContent>
                        <MudText Typo="Typo.body1">Critical settings (locked)</MudText>
                        @foreach (var item in PdmCritical.Items(View).Where(i => i.Kind is PdmCriticalKind.BitRate or PdmCriticalKind.KeptOn))
                        {
                            var kind = item.Kind;
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Style="min-width: 260px" id="@($"critical-{kind}")">@item.Label: <b>@item.Current</b></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@busy" id="@($"unlock-{kind}")"
                                           OnClick="@(() => Unlock(kind, ""))">Unlock</MudButton>
                            </MudStack>
                        }
                        <MudText Typo="Typo.caption" Style="display: block; max-width: 420px" Class="mt-2">
                            Set on the PC for A1, A2 and B: Write All sends them, Burn keeps them. A new CAN bit rate needs the ECU, the
                            dash and this PC's adapter on the same rate.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public PdmView View { get; set; } = null!;

    private bool _open = true;
    private int _warn, _crit, _hyst, _margin;
    private bool _tempDirty;
    private double _fanOn, _fanOff;
    private bool _fanDirty;
    private readonly Dictionary<string, string> _newBase = new();
    private List<string> _moveDone = [];

    private PdmHotSpotLimits TempInput => new(_warn, _crit, _hyst, _margin);
    private PdmFanThresholds FanInput => new(_fanOn, _fanOff);

    // Until the user types, the fields follow the PC values (they change with Read All / New PDM / the board pages)
    protected override void OnParametersSet()
    {
        if (PdmThermal.Current(View) is { } t) // ADR-2026-11-20-temp-onepdm: the hot-spot set, from board B
        {
            _crit = t.Crit; // editor1: locked, always the PC value (Unlock changes it)
            if (!_tempDirty) (_warn, _hyst, _margin) = (t.Warn, t.Hyst, t.Margin);
        }
        var a2 = View.Boards.FirstOrDefault(b => b.Role == "A2")?.Device;
        if (!_fanDirty && a2 != null && PdmLinked.FanLayoutProblem(a2) == null)
        {
            var c0 = PdmFactoryDefaults.FanCond0(a2);
            (_fanOn, _fanOff) = (a2.Conditions[c0].Arg, a2.Conditions[c0 + 1].Arg);
        }
    }

    private void SetTemps()
    {
        if (PdmThermal.Set(View, TempInput) is { } why) { Notification.NewError(why); return; }
        _tempDirty = false;
        Notification.NewInfo("Hot-spot limits set on the PC: board B converted, board A keeps its own. Write All sends them to the boards.");
    }

    // Board A back on its factory limits: critical temperature included, so through the Unlock dialog (type "factory")
    private async Task RestoreA()
    {
        var item = new PdmCriticalItem(PdmCriticalKind.CritTemp, "A", "Board A temperature limits back to factory",
            string.Join(" ", PdmThermal.OffFactory(View)), "type factory", "board A gets its factory warn / critical / recovery / margin");
        var parameters = new DialogParameters<PdmCriticalDialog>
        {
            { x => x.Item, item },
            { x => x.Check, (Func<string, string?>)PdmCritical.RestoreCheck }
        };
        var dialog = await DialogService.ShowAsync<PdmCriticalDialog>("Unlock board A temperature limits", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false }) return;
        PdmThermal.RestoreFactory(View);
        Notification.NewWarning("Board A temperature limits back to factory on the PC. Write All sends them, Burn keeps them.");
    }

    private void SetFan(domain.Devices.FwDevice a2)
    {
        if (PdmLinked.SetFanThresholds(a2, FanInput) is { } why) { Notification.NewError(why); return; }
        _fanDirty = false;
        Notification.NewInfo("Fan thresholds set on the PC for A2 (all six values). Write All sends them to A2.");
    }

    private void PointFan()
    {
        PdmLinked.PointFanAtBoards(View);
        Notification.NewInfo("A2's fan inputs now listen to A1 / B on the PC. Write All sends them to A2.");
    }

    private void Move(string role, int newBase)
    {
        try
        {
            var (refused, done) = Pdm.ChangeBaseId(role, newBase, AdapterManager.IsConnected);
            if (refused != null) { Notification.NewError($"{role} not moved: {refused}"); return; }
            _moveDone = done.ToList();
            _newBase[role] = "";
            Notification.NewWarning($"{role} moved to 0x{newBase:X3} (running settings only). Write All, then Burn to keep it.");
        }
        catch (Exception ex)
        {
            Notification.NewError($"Error moving {role}", ex);
        }
    }

    private static int? ParseHex(string s)
    {
        s = s.Trim();
        if (s.StartsWith("0x", StringComparison.OrdinalIgnoreCase)) s = s[2..];
        return s.Length is > 0 and <= 3 && int.TryParse(s, System.Globalization.NumberStyles.HexNumber, null, out var v) ? v : null;
    }

    // editor1 (p1 / p3): Unlock + type the new value twice + Change (PdmCriticalDialog); domain/CustomPdm/PdmCritical.cs
    private async Task Unlock(PdmCriticalKind kind, string role)
    {
        var item = PdmCritical.Items(View).Single(i => i.Kind == kind && i.Board == role);
        var parameters = new DialogParameters<PdmCriticalDialog>
        {
            { x => x.Item, item },
            { x => x.Check, (Func<string, string?>)(s => PdmCritical.Problem(View, kind, role, s)) },
            { x => x.Notes, kind == PdmCriticalKind.BaseId
                ? (Func<string, IReadOnlyList<string>>)(s => ParseHex(s) is { } nb ? PdmLinked.BaseIdWarnings(View, role, nb) : [])
                : kind == PdmCriticalKind.CritTemp ? s => PdmCritical.Notes(View, kind, s) : null }
        };
        var dialog = await DialogService.ShowAsync<PdmCriticalDialog>($"Unlock {item.Label}", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: string typed }) return;
        if (kind == PdmCriticalKind.BaseId)
        {
            Move(role, ParseHex(typed)!.Value);
            return;
        }
        if (PdmCritical.Apply(View, kind, typed) is { } why) { Notification.NewError($"{item.Label} not changed: {why}"); return; }
        Notification.NewWarning($"{item.Label}: {PdmCritical.Items(View).Single(i => i.Kind == kind).Current} on the PC for A1, A2 and B. Write All sends it, Burn keeps it.");
    }
}
